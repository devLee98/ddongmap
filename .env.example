# 브라우저에서 네이버 지도 SDK를 불러오는 공개 Client ID
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 서버에서 Geocoding API를 호출할 때 사용하는 Secret
NAVER_MAP_CLIENT_SECRET=

# 서버에서 장소 검색 API를 호출할 때 사용하는 인증 정보
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 공개 지도 Client ID와 서버 Geocoding Client ID를 분리할 때만 설정
NAVER_MAP_CLIENT_ID=
